# Photo-scan vision provider. Copy this file to `.env.local` and fill in a key.
# `.env.local` is gitignored — never commit real keys.
#
# Which provider to use for reading photos of shopping lists: gemini | anthropic
VISION_PROVIDER=gemini

# IMPORTANT: /api/scan is public — cap the key so abuse can't run up a bill.
# Gemini: don't enable billing (free tier just throttles, never charges).
# Anthropic: set a monthly spend limit / use prepaid credits. See README.

# Google AI Studio key (used when VISION_PROVIDER=gemini)
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic key (used when VISION_PROVIDER=anthropic)
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
